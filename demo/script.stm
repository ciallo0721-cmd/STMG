<
Size=1280x720
title="STMG 演示剧本"
Ver="1.0.0"
Pack="com.example.stmg.demo"
Lang="cn"
Font="Microsoft YaHei"
>
<
Start:
<-- 注册角色：参数看起来像图片路径就是立绘，否则就是注册角色名 -->
S.character("角色1")
S.character("角色2")

S.cg("bg/room.png")
S.play("music/bgm.mp3")

"这是一个用 STMG 写的演示剧本，能跑通就说明引擎没坏。"
"下面这些语句把引擎的主要功能都过了一遍，可以照着改。"

角色1"你好，我是角色1。"

STM.display("素材加载完毕（缺的图会自动画占位块）")

<-- 变量：第一次出现必须用 SET -->
SET 好感度 = 0

"桌上放着一张纸条。"

Choose:
    "读纸条":"先睡一觉"

If "读纸条":
    S.sound("music/paper.wav")
    S.picture("png/note.png")
    "纸条上写着：**今天之内要搞定这个引擎**。"
    SET 好感度 = 好感度 + 10
    角色1"哦？你是来验收的？"

If "先睡一觉":
    S.cg("bg/dark.png")
    "你睡了一觉，醒来天都黑了。"
    SET 好感度 = 好感度 - 5
    角色1"[color=#ff88bb]睡什么睡[/color]，天都黑了。"
EndIf

S.hide("picture")

"两个人凑过来看屏幕。"

<-- 询问框的提示文字：写在 STM.Q 里，也可以缩进写在 Question: 下面 -->
STM.Q = "请问你叫什么名字？"
Question:

"原来叫 [color=#7fb3ff]**" + STM.ANSWER + "**[/color] 啊。"

If 好感度 >= 10:
    角色1"嗯，你看起来挺靠谱的。"
Else:
    角色2"我觉得他不太行。"

<-- 立绘可以同时站好几张，tag 用来区分身份，pos 决定站哪 -->
S.character("png/char1.png", pos="left", tag="角色1")
S.character("png/char2.png", pos="right", tag="角色2")

"两个人站到了一起。"

S.hide("角色2")
角色1"他先走了。"

S.voice("music/voice001.wav")
角色1"来，{ruby:测测|はか}你的~~诚意~~深度。"

<-- 联网那一段只在选了「先睡一觉」的分支里跑，平时测试不会卡网络 -->
If "先睡一觉":
    R.api(url="api.example.com/ping", key=option)
    "（上面这条是 R.api 的用法示范）"

S.stop("all")
S.cg("")
S.hide("all")
>
<
"感谢游玩"
>
